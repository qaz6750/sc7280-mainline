&mdss_dsi {
	vdda-supply = <&vdd_a_dsi_0_1p2>;
	status = "disabled";

	panel: panel@0 {
		compatible = "boe,ts124qdm";
		reg = <0>;

		avdd-supply = <&panel_avdd>;
		avee-supply = <&panel_avee>;
		power-supply = <&panel_power>;
		vddi-supply = <&panel_vddi>;

