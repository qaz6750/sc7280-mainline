&pm7325_gpios {
	key_vol_up: key-vol-up-state {
		pins = "gpio6";
		function = "normal";
		input-enable;
		bias-pull-up;
		power-source = <1>;
	};
};

&pmk8350_rtc {
	status = "okay";
};

&pon_pwrkey {
	status = "okay";
	wakeup-source;
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
	wakeup-source;
};

&gpu {
	status = "disabled";
};

&i2c3 {
	clock-frequency = <400000>;
	status = "okay";

	pmic@49 {
		compatible = "siliconmitus,sm5714";
		reg = <0x49>;

		interrupt-parent = <&tlmm>;
		interrupts = <54 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&sm5714_irq>;
		pinctrl-names = "default";
		wakeup-source;

		sm5714_charger: charger {
			compatible = "siliconmitus,sm5714-charger";
			monitored-battery = <&battery>;

			sm5714_usb_otg_vbus: usb-otg-vbus {
				regulator-name = "sm5714-usb-otg-vbus";
			};
		};

		sm5714_fuel_gauge: fuel-gauge {
			compatible = "siliconmitus,sm5714-fuel-gauge";
			power-supplies = <&sm5714_charger>;
		};
	};
};

&i2c8 {
	clock-frequency = <400000>;
	status = "okay";

	typec@33 {
		compatible = "siliconmitus,sm5714-typec";
		reg = <0x33>;

		interrupt-parent = <&tlmm>;
		interrupts = <142 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&sm5714_typec_irq>;
		pinctrl-names = "default";
		vbus-supply = <&sm5714_usb_otg_vbus>;
		wakeup-source;

		connector {
			compatible = "usb-c-connector";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			typec-power-opmode = "default";

			port {
				sm5714_typec_hs: endpoint {
					remote-endpoint = <&usb_1_dwc3_hs>;
				};
			};
		};
	};
};

&mdss {
	status = "disabled";
};

